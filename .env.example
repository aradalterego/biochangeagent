# ---------------------------------------------------------------------------
# BioChange Vet Companion — environment variables
# All secrets are server-side only. Never prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# development | staging | production. staging/production refuse unsafe settings at startup
# (dev sign-in links, log email, local storage, http APP_URL, missing encryption key).
APP_ENV=development

# PostgreSQL with the pgvector extension.
# Supabase: Project Settings → Database → Connection string (use the "Session pooler" URI, port 5432,
# or the "Transaction pooler" on port 6543 for serverless). Local: postgres://postgres@localhost:5432/biochange
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biochange

# OpenAI (Responses API). The key stays on the server.
OPENAI_API_KEY=
# Main agent model (configurable).
OPENAI_MODEL=gpt-5.5
# Optional: none | minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
# Smaller model for post-response extraction/classification.
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
# Embeddings are stored as 1536-dim vectors.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

APP_URL=http://localhost:3000

# Sessions: absolute lifetime + idle timeout (veterinarians / BioChange staff).
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
STAFF_SESSION_IDLE_MINUTES=30

# Sign-in. Veterinarians: one-time email link (and optionally Google). Invite-only.
#   supabase — Supabase Auth verifies the email / Google identity (required in staging/production)
#   dev      — local one-time links printed to the server log (development only)
AUTH_PROVIDER=dev
SUPABASE_ANON_KEY=
AUTH_GOOGLE_ENABLED=false
# 32 random bytes, hex or base64 (e.g. `openssl rand -hex 32`). Encrypts staff MFA secrets.
AUTH_ENCRYPTION_KEY=
# BioChange staff must use an authenticator app (TOTP). Keep true outside local development.
STAFF_MFA_REQUIRED=true

# Email (invitations, sign-in links in dev). resend in staging/production; log = print to server log (dev only).
EMAIL_DRIVER=log
RESEND_API_KEY=
EMAIL_FROM=BioChange <no-reply@biochange.life>

# Scheduled jobs (follow-up reminders). Vercel Cron sends "Authorization: Bearer <CRON_SECRET>".
# At least 32 random characters (e.g. `openssl rand -hex 32`); required in staging/production.
CRON_SECRET=

# Product areas outside the MVP, off unless listed: inventory,orders,adoption,education (or "all").
FEATURES=

# File storage for uploaded knowledge documents and case files.
#   local    — ./storage on disk (development)
#   supabase — private Supabase Storage bucket (production)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-files

# Hosts an admin may ingest knowledge from by URL (comma-separated; subdomains included).
KNOWLEDGE_FETCH_ALLOWED_HOSTS=biochange.life,frontiersin.org

# Seeding. Demo accounts are opt-in, need a password, and are refused for non-local databases
# unless ALLOW_DEMO_IN_PRODUCTION=true (disposable staging only). Demo accounts cannot sign in
# when APP_ENV is staging/production unless that flag is set.
SEED_DEMO=false
DEMO_PASSWORD=
ALLOW_DEMO_IN_PRODUCTION=false

# Max chat messages per user per 10 minutes (limits model spend).
CHAT_LIMIT_PER_10_MIN=40
