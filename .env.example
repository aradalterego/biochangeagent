# ---------------------------------------------------------------------------
# BioChange Vet Companion — environment variables
# All secrets are server-side only. Never prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# PostgreSQL with the pgvector extension.
# Supabase: Project Settings → Database → Connection string (use the "Session pooler" URI, port 5432,
# or the "Transaction pooler" on port 6543 for serverless). Local: postgres://postgres@localhost:5432/biochange
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biochange

# OpenAI (Responses API). The key stays on the server.
OPENAI_API_KEY=
# Main agent model (configurable).
OPENAI_MODEL=gpt-5.5
# Optional: none | minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
# Smaller model for post-response extraction/classification.
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
# Embeddings are stored as 1536-dim vectors.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

APP_URL=http://localhost:3000
SESSION_TTL_HOURS=12

# File storage for uploaded knowledge documents and case files.
#   local    — ./storage on disk (development)
#   supabase — private Supabase Storage bucket (production)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-files

# Hosts an admin may ingest knowledge from by URL (comma-separated; subdomains included).
KNOWLEDGE_FETCH_ALLOWED_HOSTS=biochange.life,frontiersin.org

# Seeding. Demo accounts are opt-in, need a password, and are refused for non-local databases
# unless ALLOW_DEMO_IN_PRODUCTION=true (disposable staging only).
SEED_DEMO=false
DEMO_PASSWORD=

# Max chat messages per user per 10 minutes (limits model spend).
CHAT_LIMIT_PER_10_MIN=40
